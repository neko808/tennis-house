# ── The Tennis House — environment template ─────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.

# Medusa backend (Phase 1: leave empty — the storefront runs on the local
# clearly-labeled sample catalog. Set these to switch to a real Medusa server.)
MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Server-side only. NEVER expose with NEXT_PUBLIC_.
MEDUSA_ADMIN_API_KEY=
DATABASE_URL=
